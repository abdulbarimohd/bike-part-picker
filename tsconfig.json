{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  // Tests run via tsx, never shipped — keeping them out of the build
  // means the runtime image carries no test code.
  "exclude": ["node_modules", "dist", "web", "prisma/seed.ts", "src/**/*.test.ts"]
}

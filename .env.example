# Copy to .env and fill in. Never commit the real .env.
#
# Generate strong values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

POSTGRES_USER=bikepp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bikepp

# The API refuses to start without this (see src/middleware/auth.middleware.ts).
JWT_SECRET=change-me

# Baked into the frontend bundle at build time — must be the URL the
# BROWSER can reach, not the compose-internal `api:4000`.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Only for host-side prisma commands (migrate/seed/studio). The api
# container builds its own DATABASE_URL from the POSTGRES_* vars above.
DATABASE_URL=postgresql://bikepp:change-me@localhost:5432/bikepp
